{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "git": {
        "deploymentEnabled": {
            "adding-clubs": false
        }
    },
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "nextjs",
            "bindings": [
                {
                    "type": "service",
                    "service": "backend",
                    "format": "url",
                    "env": "BACKEND_INTERNAL_URL"
                }
            ]
        },
        "backend": {
            "root": "backend",
            "framework": "fastapi",
            "entrypoint": "main:app",
            "rewrites": [
                {
                    "source": "/backend/:path(.*)",
                    "destination": "/:path"
                }
            ]
        }
    },
    "rewrites": [
        {
            "source": "/backend/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/backend",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "frontend"
            }
        }
    ]
}